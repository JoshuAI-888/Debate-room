# Viewer mode uses Claude Code; no inference key is needed.
COUNCIL_RUNNER=viewer

# For direct web debates set COUNCIL_RUNNER=api.
# Providers: anthropic | openrouter | openai (OpenAI-compatible servers).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# standard | budget. Budget uses cheaper models, compact brains and Quick by default.
INFERENCE_PROFILE=standard

# Optional model overrides. Leave commented to use the selected provider's preset.
# SEAT_MODEL=claude-haiku-4-5
# CHAIR_MODEL=claude-sonnet-4-6
# BRAIN_CONTEXT=compact

# For OpenRouter/OpenAI-compatible Chair: json_schema | json_object | prompt.
# JSON_OUTPUT_MODE=json_schema
# INFERENCE_TIMEOUT_MS=120000
