COUNCIL_RUNNER=api
AI_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_ALLOW_NO_KEY=true
# Change these to model names installed on your local server.
SEAT_MODEL=qwen3:8b
CHAIR_MODEL=qwen3:8b
INFERENCE_PROFILE=budget
# Use prompt if your server has no response_format support.
# json_schema is preferable when your server supports it.
JSON_OUTPUT_MODE=prompt
